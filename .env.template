# OpenCode launcher settings — copy to .env and fill in. Never commit .env.
# Used by scripts/opencode.sh via load_env_file.

# ── Model selection (optional) ───────────────────────────────────────────────
# Precedence: these env vars → the existing opencode.json → built-in default.
# So you can also just edit opencode.json by hand and the launcher will keep it.
# Leave both blank to accept the default. The default path starts no local
# process; see docs/adr/0002-declare-model-tiers-never-auto-route.md
# DEFAULT_MODEL=opencode/space-bunny-free
# DEFAULT_SMALL_MODEL=opencode/space-bunny-free
# Use a T-Systems model instead, e.g. DEFAULT_MODEL=tsystems/Qwen3.6-35B-A3B-FP8
# Use the local model, which needs `devbox run opencode-ollama`:
# DEFAULT_MODEL=ollama/hhao/qwen2.5-coder-tools:7b

# T-Systems LLM Hub (provider in opencode.json)
TSYSTEMS_OPENCODE_API_KEY=

# Jira MCP (mcp-atlassian via uvx)
JIRA_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=

# Optional: GitHub MCP remote (only if a target folder's opencode.json references it)
GITHUB_PERSONAL_ACCESS_TOKEN=
